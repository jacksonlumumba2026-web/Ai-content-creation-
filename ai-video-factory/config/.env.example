# Copy to config/.env and fill in ONLY the keys you have decided to use.
# config/.env is git-ignored. Never commit real keys.
# In Claude Code on the web, prefer adding these as environment secrets instead.

# --- Voice (TTS) ---
ELEVENLABS_API_KEY=

# --- Stock media (free tiers) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Publishing / scheduling ---
METRICOOL_API_TOKEN=
OPUSCLIP_API_KEY=

